# =============================================================================
# .dockerignore — 不让这些文件进入 Docker 构建上下文
# 目的:加速构建、缩小镜像、避免敏感信息泄露
# =============================================================================

# Git
.git
.gitignore
.gitattributes
.github

# 文档(README/AGENTS 等都不需要进镜像)
*.md
LICENSE
docs/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 本地环境配置(不能把 API key 烧进镜像)
.env
.env.local
.env.*.local

# Docker 相关文件本身(避免循环引用)
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Node 依赖与构建产物(在镜像里重新装)
node_modules
.next
out
build
dist
*.tsbuildinfo
coverage

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.bun

# 测试
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
test/
tests/

# 临时文件
tmp/
temp/
.cache/
.eslintcache

# 容器相关运行时数据(应该挂载,不能进镜像)
agent-data/
workspace/
